[Unit]
Description=morozovka-bridge Web UI
After=network-online.target openvpn-client@client.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/bridge-webui
Environment="PI_VPN_IP=10.8.0.2"
Environment="EXTERNAL_HOST=31.128.43.79"
Environment="EXTERNAL_SSH_PORT=22"
Environment="EXTERNAL_SSH_USER=root"
Environment="SSH_KEY=/root/.ssh/id_ed25519"
Environment="WEB_HOST=0.0.0.0"
Environment="WEB_PORT=8080"
Environment="WEB_PASSWORD=change-me-please"
EnvironmentFile=-/etc/bridge-webui.env
ExecStart=/opt/bridge-webui/venv/bin/python /opt/bridge-webui/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
