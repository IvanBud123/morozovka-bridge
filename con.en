# ============================================================
#  morozovka-bridge — конфигурация
# ============================================================

# ---------- Внешний сервер с белым IP ----------
EXTERNAL_HOST="95.163.232.136"           # IP или домен внешнего сервера
EXTERNAL_SSH_PORT="22"
EXTERNAL_SSH_USER="root"
EXTERNAL_SSH_PASSWORD="ВашПароль"        # нужен только для первой установки

# ---------- OpenVPN ----------
VPN_PORT="1194"
VPN_PROTO="udp"                          # оставь udp
VPN_NETWORK="10.8.0.0"
VPN_NETMASK="255.255.255.0"
EXTERNAL_VPN_IP="10.8.0.1"
PI_VPN_IP="10.8.0.2"                     # фиксированный IP Малинки в VPN

# ---------- Локальная сеть Малинки ----------
PI_LAN_INTERFACE="eth0"
PI_LAN_IP="192.168.50.1"

# ============================================================
#  Сервисы
#  Формат: "имя|домен|внутренний_ip|внутренний_порт|vpn_порт|тип|внешний_порт"
# ============================================================
SERVICES=(
  # Пример: GitTea на сервере 2, наружу на порт 8080
  "gittea|_|192.168.50.2|3000|8080|http|8080"

  # Пример: SSH к серверу 2, наружу на 8022
  "ssh-srv2|_|192.168.50.2|22|8022|tcp|8022"
)